---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import SplitText from '../../components/SplitText.astro';
import { site, whatsappHref } from '../../data/site';

export const getStaticPaths = (async () => {
  const entries = await getCollection('work');
  const ordered = entries.sort((a, b) => a.data.order - b.data.order);

  return ordered.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      next: ordered[(i + 1) % ordered.length],
      position: i + 1,
      total: ordered.length,
    },
  }));
}) satisfies GetStaticPaths;

const { entry, next, position, total } = Astro.props;
const { Content } = await render(entry);

const facts = [
  { label: 'Client', value: entry.data.client },
  ...(entry.data.role ? [{ label: 'My role', value: entry.data.role }] : []),
  { label: 'Domain', value: entry.data.sector },
  { label: 'Year', value: String(entry.data.year) },
  { label: 'Services', value: entry.data.services.join(', ') },
  { label: 'Stack', value: entry.data.stack.join(', ') },
  ...(entry.data.repo ? [{ label: 'Source', value: entry.data.repo, mono: true }] : []),
];
---

<Base title={entry.data.title} description={entry.data.summary} type="article">
  <article>
    <header class="case">
      <div class="container">
        <a class="link case__back" href="/#systems">
          <span aria-hidden="true">←</span>
          All systems
        </a>

        <div class="case__top">
          <span class="case__code">{entry.data.code}</span>
          <span class="index">
            {String(position).padStart(2, '0')} / {String(total).padStart(2, '0')}
          </span>
        </div>

        <h1 class="h2 case__title">
          <SplitText text={entry.data.title} mode="load" delay={120} />
        </h1>

        <p class="case__outcome">{entry.data.outcome}</p>

        {
          entry.data.awards.length > 0 && (
            <ul class="case__awards">
              {entry.data.awards.map((award, i) => (
                <li class="case__award m-rise" style={`--i:${i}`}>
                  <span class="case__award-mark" aria-hidden="true">
                    ◆
                  </span>
                  {award}
                </li>
              ))}
            </ul>
          )
        }

        <dl class="case__facts">
          {
            facts.map((fact, i) => (
              <div class="case__fact m-rise" style={`--i:${i}`}>
                <dt class="case__fact-k">{fact.label}</dt>
                <dd class:list={['case__fact-v', { 'case__fact-v--mono': fact.mono }]}>
                  {fact.value}
                </dd>
              </div>
            ))
          }
        </dl>

        {
          entry.data.demo && (
            <a class="btn case__demo" href={`/#${entry.data.demo}`}>
              Try the live demo
              <span class="btn__arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
      </div>
    </header>

    <div class="container case__body">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <nav class="section next" aria-label="Next case study">
    <div class="container">
      <p class="eyebrow m-rise">Next system</p>
      <a class="next__link" href={`/work/${next.id}`}>
        <h2 class="h2 next__title">
          <SplitText text={next.data.title} />
        </h2>
        <span class="next__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </nav>

  <section class="section on-ink case__cta">
    <div class="container case__cta-inner">
      <div>
        <p class="eyebrow m-rise">Similar problem?</p>
        <h2 class="h2 case__cta-title m-rise">Let's talk about yours.</h2>
      </div>
      <a class="btn btn--on-ink" href={whatsappHref} target="_blank" rel="noopener">
        Message {site.name.split(' ')[0]}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .case {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--line-soft);
  }

  .case__back {
    color: var(--muted);
  }

  .case__top {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .case__code {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--accent-line);
    border-radius: 3px;
    color: var(--accent);
  }

  .case__title {
    margin-top: 0.75rem;
    max-width: 20ch;
  }

  .case__outcome {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 44ch;
  }

  .case__awards {
    list-style: none;
    padding: 0;
    margin: clamp(1.25rem, 3vw, 1.75rem) 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .case__award {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .case__award-mark {
    color: var(--accent);
    font-size: 0.7em;
    flex: none;
  }

  .case__facts {
    display: grid;
    grid-template-columns: 1fr;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
  }

  .case__fact {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--line-soft);
  }

  .case__fact:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  .case__fact-k {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .case__fact-v {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .case__fact-v--mono {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
    word-break: break-all;
  }

  .case__demo {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .case__body {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .next {
    border-top: 1px solid var(--line-soft);
  }

  .next__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.25rem;
    transition: color 0.4s var(--ease);
  }

  .next__title {
    max-width: 20ch;
  }

  .next__arrow {
    font-size: var(--step-3);
    flex: none;
    transition: transform 0.5s var(--ease);
  }

  .next__link:hover {
    color: var(--accent);
  }

  .next__link:hover .next__arrow {
    transform: translateX(10px);
  }

  .case__cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .case__cta-title {
    margin-top: 0.85rem;
  }

  @media (min-width: 46rem) {
    .case__fact {
      grid-template-columns: 9rem 1fr;
      gap: 1.5rem;
      align-items: baseline;
    }
  }
</style>
