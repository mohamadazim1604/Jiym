---
import Base from '../layouts/Base.astro';
import SplitText from '../components/SplitText.astro';
---

<Base title="Page not found" description="That page does not exist.">
  <section class="section notfound">
    <div class="container">
      <p class="eyebrow">HTTP 404</p>
      <h1 class="display notfound__title">
        <SplitText text="That page does" mode="load" delay={100} />
        <SplitText text="not exist." mode="load" delay={100} offset={3} italic />
      </h1>
      <p class="lede notfound__lede rise rise-3">
        The link may be old, or something moved. The systems are all still here.
      </p>
      <div class="notfound__actions rise rise-4">
        <a class="btn" href="/">
          Back to the homepage
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="/#systems">See the work</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .notfound__title {
    margin-top: 1.25rem;
    max-width: 14ch;
  }

  .notfound__lede {
    margin-top: 1.5rem;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2.25rem;
  }
</style>
