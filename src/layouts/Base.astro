---
import '@fontsource-variable/sora/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Cursor from '../components/Cursor.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description = site.description, image = '/og.png', type = 'website' } = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}, ${site.location}`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const socialImage = new URL(image, Astro.site ?? site.url);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  description: site.description,
  url: site.url,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kuala Lumpur',
    addressCountry: 'MY',
  },
  knowsAbout: [
    'Web application development',
    'Full-stack development',
    'API development',
    'Database design',
    'Internal business tools',
    '.NET Core',
    'Angular',
  ],
  sameAs: site.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#070910" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content="en_MY" />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- Ambient field. Three fixed layers behind the whole document: footage,
         a veil that buys the text its contrast back, and a slow colour mesh.
         Never still, but nothing sweeps across it and nothing is tiled. -->
    <div class="field" aria-hidden="true">
      <video
        class="field__video"
        src="/media/ambient.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        disablepictureinpicture
        tabindex="-1"></video>
      <div class="field__veil"></div>
      <div class="field__mesh"></div>
    </div>

    <!-- Film grain, over everything including the header. Click-through by
         `pointer-events: none`; see the .grain rule for why it exists. -->
    <div class="grain" aria-hidden="true"></div>

    <Cursor />

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { motionValue, springValue } from 'motion';

      const reducedQuery = matchMedia('(prefers-reduced-motion: reduce)');

      /**
       * Ambient video. Decoding a looping clip forever is the most expensive
       * thing on the page, so it only ever runs when it is actually being
       * looked at and actually wanted: paused on a hidden tab, on Data Saver,
       * and under prefers-reduced-motion, where the first frame is left up as
       * a still.
       */
      const ambient = document.querySelector<HTMLVideoElement>('.field__video');

      if (ambient) {
        const saveData = (navigator as any).connection?.saveData === true;

        const settleVideo = () => {
          if (reducedQuery.matches || saveData || document.hidden) {
            ambient.pause();
          } else {
            // Rejected autoplay is not an error worth surfacing: the veil and
            // the colour mesh still carry the page on their own.
            ambient.play().catch(() => {});
          }
        };

        reducedQuery.addEventListener('change', settleVideo);
        document.addEventListener('visibilitychange', settleVideo);
        settleVideo();
      }

      /**
       * Magnetic pull on the primary actions. The element leans toward the
       * cursor by a fraction of the distance from its own centre, capped at
       * 6px so it never looks like it is running away from the pointer.
       * Pointer-only, and coalesced to one frame like the lamp below.
       */
      const magnets = document.querySelectorAll<HTMLElement>('.magnetic');

      if (magnets.length && !reducedQuery.matches && matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const CAP = 6;
        let magQueued = false;
        let magNext: { el: HTMLElement; x: number; y: number } | null = null;

        const magFlush = () => {
          magQueued = false;
          if (!magNext) return;
          magNext.el.style.setProperty('--mag-x', `${magNext.x.toFixed(1)}px`);
          magNext.el.style.setProperty('--mag-y', `${magNext.y.toFixed(1)}px`);
          magNext = null;
        };

        for (const magnet of magnets) {
          magnet.addEventListener('pointermove', (event) => {
            const box = magnet.getBoundingClientRect();
            const dx = event.clientX - (box.left + box.width / 2);
            const dy = event.clientY - (box.top + box.height / 2);
            magNext = {
              el: magnet,
              x: Math.max(-CAP, Math.min(CAP, dx * 0.25)),
              y: Math.max(-CAP, Math.min(CAP, dy * 0.35)),
            };
            if (magQueued) return;
            magQueued = true;
            requestAnimationFrame(magFlush);
          });

          magnet.addEventListener('pointerleave', () => {
            magnet.style.setProperty('--mag-x', '0px');
            magnet.style.setProperty('--mag-y', '0px');
          });
        }
      }

      /**
       * 3D tilt, on springs.
       *
       * Any `[data-tilt]` leans toward the pointer on two axes, and anything
       * inside it marked `[data-tilt-lift]` slides a few pixels the OTHER
       * way. That counter-movement is what actually sells the depth: a card
       * that only rotates reads as a flat picture of a card being turned,
       * while contents drifting against the rotation read as sitting above
       * the surface at a real distance from it.
       *
       * True `translateZ` would be the textbook way to do that and it does
       * not work here — every one of these cards clips its own overflow, and
       * `overflow: hidden` forces `transform-style` back to flat, collapsing
       * any Z the children were given. The parallax is the honest workaround.
       *
       * The four values are sprung rather than transitioned. A CSS transition
       * restarts from wherever it was every time the pointer moves, so under
       * a continuously moving cursor it never finishes and the card reads as
       * permanently behind. A spring has a velocity that survives each new
       * target, so the card tracks the pointer and still overshoots when it
       * is released.
       *
       * The per-card frame loop only runs while there is something to draw:
       * it stops itself once the pointer is gone AND every spring has come to
       * rest, so ten idle cards cost nothing.
       */
      const tilts = [...document.querySelectorAll<HTMLElement>('[data-tilt]')];

      if (tilts.length && !reducedQuery.matches && matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const MAX = 7;
        const SPRING = { stiffness: 250, damping: 24, mass: 0.5 };

        for (const card of tilts) {
          const targets = {
            rx: motionValue(0),
            ry: motionValue(0),
            px: motionValue(0),
            py: motionValue(0),
          };

          const springs = {
            rx: springValue(targets.rx, SPRING),
            ry: springValue(targets.ry, SPRING),
            px: springValue(targets.px, SPRING),
            py: springValue(targets.py, SPRING),
          };

          let raf = 0;
          let over = false;

          const draw = () => {
            card.style.setProperty('--rx', `${springs.rx.get().toFixed(2)}deg`);
            card.style.setProperty('--ry', `${springs.ry.get().toFixed(2)}deg`);
            card.style.setProperty('--px', `${springs.px.get().toFixed(2)}px`);
            card.style.setProperty('--py', `${springs.py.get().toFixed(2)}px`);

            const settling = Object.values(springs).some(
              (value) => Math.abs(value.getVelocity()) > 0.05,
            );

            raf = over || settling ? requestAnimationFrame(draw) : 0;
          };

          const kick = () => {
            if (!raf) raf = requestAnimationFrame(draw);
          };

          card.addEventListener('pointermove', (event) => {
            const box = card.getBoundingClientRect();
            // -0.5 … 0.5 from the centre of the card, on both axes.
            const ox = (event.clientX - box.left) / box.width - 0.5;
            const oy = (event.clientY - box.top) / box.height - 0.5;

            over = true;
            targets.rx.set(-oy * MAX * 2);
            targets.ry.set(ox * MAX * 2);
            targets.px.set(-ox * 14);
            targets.py.set(-oy * 10);
            kick();
          });

          card.addEventListener('pointerleave', () => {
            over = false;
            for (const value of Object.values(targets)) value.set(0);
            kick();
          });
        }
      }

      /**
       * Copy to clipboard. Any [data-copy] button puts its value on the
       * clipboard and confirms in place for a moment. The contact details are
       * still ordinary links beside it, so nothing depends on this working.
       */
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          const value = button.dataset.copy;
          if (!value) return;

          try {
            await navigator.clipboard.writeText(value);
          } catch {
            // Denied permission or an insecure origin. Say nothing rather
            // than claiming a copy that did not happen.
            return;
          }

          button.classList.add('is-copied');
          const label = button.querySelector('.copy__text');
          if (label) label.textContent = 'Copied';

          setTimeout(() => {
            button.classList.remove('is-copied');
            if (label) label.textContent = 'Copy';
          }, 1600);
        });
      }

      /**
       * Pointer lamp. Feeds the cursor position to any `.glow` surface as a
       * percentage pair, which CSS turns into a radial highlight. Coalesced
       * into one rAF per frame so a fast drag across a four-card grid still
       * costs a single style recalculation.
       */
      const lamps = document.querySelectorAll<HTMLElement>('.glow');

      if (lamps.length && !reducedQuery.matches && matchMedia('(hover: hover)').matches) {
        let queued = false;
        let pending: { el: HTMLElement; x: number; y: number } | null = null;

        const flush = () => {
          queued = false;
          if (!pending) return;
          pending.el.style.setProperty('--mx', `${pending.x}%`);
          pending.el.style.setProperty('--my', `${pending.y}%`);
          pending = null;
        };

        for (const lamp of lamps) {
          lamp.addEventListener('pointermove', (event) => {
            const box = lamp.getBoundingClientRect();
            pending = {
              el: lamp,
              x: ((event.clientX - box.left) / box.width) * 100,
              y: ((event.clientY - box.top) / box.height) * 100,
            };
            if (queued) return;
            queued = true;
            requestAnimationFrame(flush);
          });
        }
      }
    </script>

    <style>
      /* The field sits at z-index 0, so anything carrying content has to be
         raised above it explicitly. */
      main,
      :global(.site-footer) {
        position: relative;
        z-index: 1;
      }
    </style>
  </body>
</html>
