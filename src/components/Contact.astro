---
import SplitText from './SplitText.astro';
import BlockField from './BlockField.astro';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { site, whatsappHref, mailtoHref } from '../data/site';

/* Direct channels, not a contact form. A form needs a backend, attracts spam,
   and people quietly distrust it because they have all had one vanish. */
const channels: { label: string; value: string; href: string; external: boolean; icon: IconName }[] = [
  { label: 'WhatsApp', value: site.phoneDisplay, href: whatsappHref, external: true, icon: 'whatsapp' },
  { label: 'Email', value: site.email, href: mailtoHref, external: false, icon: 'mail' },
];
---

<section class="section on-ink contact has-field" id="contact">
  <BlockField variant="horizon" tone="deep" depth="3rem" />
  <span class="scanline" aria-hidden="true"></span>

  <div class="container">
    <p class="section__no m-rise" data-no="05">Next step</p>

    <h2 class="display contact__title">
      <SplitText text="Tell me what is" />
      <SplitText text="slowing you down." offset={3} italic />
    </h2>

    <p class="lede contact__lede m-rise">
      A short call, no charge and no pitch deck. If I am not the right person for it I will say so
      and point you at someone who is.
    </p>

    <ul class="contact__channels">
      {
        channels.map((channel, i) => (
          <li class="contact__row m-rise" style={`--i:${i}`}>
            <a
              class="contact__link"
              href={channel.href}
              target={channel.external ? '_blank' : undefined}
              rel={channel.external ? 'noopener' : undefined}
            >
              <span class="contact__label">
                <span class="contact__glyph">
                  <Icon name={channel.icon} size="1.15rem" />
                </span>
                {channel.label}
              </span>
              <span class="contact__value">{channel.value}</span>
              <span class="contact__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="contact__foot m-rise">
      <span class:list={['status', { 'status--closed': !site.available }]}>
        <span class="status__dot" aria-hidden="true"></span>
        {site.available ? site.availableFrom : 'Fully booked, enquiries still welcome'}
      </span>
    </div>
  </div>
</section>

<style>
  /* `position` and `overflow` come from `.has-field`. */
  .contact {
    background-color: var(--deep);
  }

  .contact__title {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    max-width: 15ch;
  }

  .contact__lede {
    color: var(--deep-muted);
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    max-width: 50ch;
  }

  .contact__channels {
    list-style: none;
    padding: 0;
    margin: clamp(1.75rem, 3.5vw, 2.75rem) 0 0;
  }

  .contact__row {
    border-top: 1px solid var(--deep-line);
  }

  .contact__row:last-child {
    border-bottom: 1px solid var(--deep-line);
  }

  .contact__link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.3rem 2rem;
    padding-block: clamp(1.15rem, 2.5vw, 1.7rem);
    transition: color 0.4s var(--ease), padding-inline 0.5s var(--ease);
  }

  .contact__label {
    grid-column: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .contact__glyph {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--deep-line);
    border-radius: var(--radius);
    color: var(--accent-2);
    flex: none;
    transition:
      border-color 0.45s var(--ease),
      transform 0.45s var(--ease);
  }

  .contact__link:hover .contact__glyph {
    border-color: var(--accent-2);
    transform: scale(1.08);
  }

  .contact__value {
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--deep-muted);
    transition: color 0.4s var(--ease);
  }

  .contact__arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: var(--step-2);
    transition: transform 0.5s var(--ease);
  }

  .contact__link:hover {
    color: var(--accent-2);
    padding-inline: 0.65rem;
  }

  .contact__link:hover .contact__value {
    color: var(--accent-2);
  }

  .contact__link:hover .contact__arrow {
    transform: translateX(8px);
  }

  .contact__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 40rem) {
    .contact__link {
      /* `auto`, not a fixed `minmax(0, 12rem)`. The label is set at display
         size, and "WhatsApp" plus its glyph is wider than 12rem the moment
         the type scale reaches its cap — the column clamped, the text spilled
         out of it, and the phone number was printed straight through the
         middle of the word. A content-sized column cannot collide. */
      grid-template-columns: auto 1fr auto;
    }

    .contact__value {
      grid-column: 2;
    }

    .contact__arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
