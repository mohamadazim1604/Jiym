---
/**
 * Splits a string into mask boxes so each unit can slide up from behind a hard
 * edge on a stagger. A unit is a whole word by default, or a single letter when
 * `chars` is set — the letter split is reserved for the hero headline, where
 * the tighter stagger is what makes the line read as typeset rather than
 * animated.
 *
 * The split happens at BUILD TIME, the browser receives finished markup and
 * ships no JavaScript to do it. That is the whole reason this effect is cheap
 * enough to use as liberally as it is here.
 */
interface Props {
  text: string;
  /**
   * `load` fires on page load (for content already above the fold).
   * `scroll` welds the stagger to scroll position.
   */
  mode?: 'load' | 'scroll';
  /** Index to start the stagger from, so two blocks can share one cascade. */
  offset?: number;
  /** Delay before a `load` cascade begins, in ms. */
  delay?: number;
  class?: string;
  italic?: boolean;
  /** Split to individual letters instead of whole words. */
  chars?: boolean;
}

const {
  text,
  mode = 'scroll',
  offset = 0,
  delay = 0,
  class: className = '',
  italic = false,
  chars = false,
} = Astro.props;

const words = text.split(/\s+/).filter(Boolean);

/* Numbered here rather than in the template, because both numbers have to keep
   counting ACROSS word boundaries: `--i` so the stagger runs through the line
   as one cascade instead of restarting at every space, and `--p` so an accent
   gradient can be sampled at the right point of the line by each letter. */
let n = 0;
const boxes = words.map((word) =>
  (chars ? Array.from(word) : [word]).map((unit) => ({ unit, n: n++ }))
);
const last = Math.max(n - 1, 1);
---

<span
  class:list={[
    'split',
    mode === 'load' ? 'split--load' : 'split--scroll',
    { 'split--chars': chars },
    className,
    { accentuate: italic },
  ]}
  style={`--base:${delay}ms;--n:${n}`}
>
  {
    boxes.map((units) => (
      <Fragment>
        <span class="split__w">
          {units.map(({ unit, n }) => (
            <span
              class="split__i"
              style={`--i:${n + offset};--p:${((n / last) * 100).toFixed(2)}%`}
            >
              {unit}
            </span>
          ))}
        </span>
        {/* A REAL space after every word box, not a margin.
            The boxes are inline-block, so a margin would space them apart for
            the eye while leaving the DOM one unbroken string — the headline
            copied to the clipboard as "Ibuildsystemsthat...", and a screen
            reader and a crawler both read it that way too.

            It trails rather than leads so that two of these components set
            side by side in one heading are separated as well. HTML collapses
            the trailing space on the last word away, so it costs nothing at
            the end of a line. */}
        {' '}
      </Fragment>
    ))
  }
</span>
