---
import SplitText from './SplitText.astro';
import BlockField from './BlockField.astro';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { site } from '../data/site';

/* One glyph per shape of work, keyed by the same three-letter code the card
   already carries. Drawn from what the work IS — a terminal for a built
   application, a two-way movement for an integration — rather than a generic
   gear repeated four times. */
const glyphs: Record<string, IconName> = {
  WEB: 'terminal',
  APP: 'mobile',
  SHOP: 'cart',
  API: 'transaction',
};
---

{/* Replaces the old scrolling type band. Four problem shapes, each with a mono
    code, rendered as an instrument row rather than decoration. */}
<section class="section section--alt caps has-field" id="capabilities">
  <BlockField variant="mesh" />

  <div class="container">
    <header class="caps__head reveal-set">
      <p class="section__no" data-no="02">Capabilities</p>
      <h2 class="h2">
        <SplitText text="Four core services." />
        <SplitText text="One standard of delivery." offset={3} italic />
      </h2>
      <p class="lede">
        Each one taken end to end, from the first conversation through to working software your
        team can rely on.
      </p>
    </header>

    <ol class="caps__grid reveal">
      {
        site.services.map((service, i) => (
          <li class="caps__card sheen glow lift" style={`--i:${i}`}>
            <div class="caps__top">
              <span class="caps__glyph">
                <Icon name={glyphs[service.code] ?? 'stack'} size="1.35rem" />
              </span>
              <span class="caps__num">{String(i + 1).padStart(2, '0')}</span>
            </div>

            <span class="caps__code">{service.code}</span>

            <h3 class="caps__title">{service.title}</h3>
            <p class="caps__summary">{service.summary}</p>

            <ul class="caps__list">
              {service.includes.map((item) => (
                <li class="caps__item">{item}</li>
              ))}
            </ul>

            <span class="caps__bar" aria-hidden="true" />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .caps__head {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 46rem;
  }

  .caps__grid {
    list-style: none;
    padding: 0;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    /* Real whitespace, not a 1px hairline gap.

       This grid used to draw its own dividers with a trick: a 1px gap over a
       tinted background, so the ground showed through between the cards as a
       hairline. With the hairline tokens off that background is transparent
       and the trick collapses — four cards mashed edge to edge with a 1px
       crack between them, reading as one undifferentiated block of text.

       Whitespace has to do the separating instead, and it needs real room to
       do it: 1px of gap becomes 3rem. */
    gap: clamp(2.25rem, 4vw, 3rem);
  }

  .caps__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.5rem, 3vw, 2.1rem);
    /* `background-color`, not the shorthand, so `.glow` keeps its lamp. */
    background-color: var(--surface);
    overflow: hidden;
    transition: background-color 0.45s var(--ease);
  }

  .caps__card:hover {
    background-color: var(--surface-2);
  }

  .caps__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }

  /* The glyph sits in its own bevelled well, which is what makes it read as a
     component of an instrument rather than an illustration dropped on a card. */
  .caps__glyph {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(160deg, var(--surface-2), transparent);
    color: var(--accent-2);
    transition:
      color 0.45s var(--ease),
      border-color 0.45s var(--ease),
      transform 0.5s var(--ease);
  }

  .caps__card:hover .caps__glyph {
    color: var(--accent);
    border-color: var(--accent-line);
    transform: translateY(-2px) scale(1.06);
  }

  /* The three-letter code is the whole personality of this card. */
  .caps__code {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.16em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .caps__num {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--faint);
  }

  .caps__title {
    font-size: var(--step-2);
  }

  .caps__summary {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--muted);
  }

  .caps__list {
    list-style: none;
    padding: 0;
    margin: 0.35rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .caps__item {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-2);
    padding-top: 0.45rem;
    border-top: 1px solid var(--line-soft);
  }

  .caps__item::before {
    content: '';
    width: 3px;
    height: 3px;
    background: var(--accent);
    flex: none;
    transform: translateY(-2px);
  }

  /* Accent bar that grows along the bottom edge on hover. */
  .caps__bar {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }

  .caps__card:hover .caps__bar {
    transform: scaleX(1);
  }

  @media (min-width: 44rem) {
    .caps__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 72rem) {
    .caps__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
