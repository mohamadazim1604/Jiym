---
import { Image } from 'astro:assets';
import SplitText from './SplitText.astro';
import BlockField from './BlockField.astro';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import portrait from '../assets/azim-portrait.jpeg';
import { site } from '../data/site';

/* One glyph per stack group, in the order the groups are declared. */
const groupGlyphs: IconName[] = ['model', 'terminal', 'trace', 'blocks'];
---

<section class="section section--alt about has-field" id="about">
  <BlockField variant="halo" depth="3.5rem" />

  <div class="container about__grid">
    {/* Portrait. A real face is a trust signal: someone is deciding whether to
        hand money to a stranger.

        Image rather than a plain img tag: it resizes, converts and hashes the
        source at build time and writes the intrinsic width and height in, so
        the block reserves its space before the file arrives.

        widths never goes above 720, because the source file IS 720x1080 —
        asking the build for a 1000px variant upscaled it, and an upscale is
        exactly what blurry looks like. The frame is capped to 22rem to match,
        so the widest variant still covers a 2x display one for one. */}
    <figure class="about__figure m-wipe ticked">
      <Image
        class="about__img m-zoom"
        src={portrait}
        alt={`${site.name}, ${site.role.toLowerCase()} based in ${site.location}`}
        widths={[360, 540, 720]}
        sizes="(min-width: 56rem) 22rem, 92vw"
        format="webp"
        quality={82}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="about__text">
      <p class="section__no m-rise" data-no="04">About</p>

      <h2 class="h2 about__heading">
        <SplitText text="You deal with me," />
        <SplitText text="start to finish." offset={3} italic />
      </h2>

      {
        site.about.body.map((paragraph, i) => (
          <p class="about__para m-rise" style={`--i:${i}`}>
            {paragraph}
          </p>
        ))
      }

      <dl class="about__stack">
        {
          site.about.stack.map((group, i) => (
            <div class="about__group m-rise" style={`--i:${i}`}>
              <dt class="about__group-name">
                <Icon name={groupGlyphs[i] ?? 'stack'} size="0.95rem" />
                {group.group}
              </dt>
              <dd class="about__group-items">
                {group.items.map((item) => (
                  <span class="about__chip">{item}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: start;
  }

  .about__figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line-soft);
  }

  /* Intrinsic 2:3, uncropped and never magnified. Forcing it to 4:5 with
     `object-fit: cover` cut into the frame and scaled what was left up past
     the source resolution, which is where the softness came from. */
  .about__img {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.86) brightness(0.94);
    transition: filter 0.7s var(--ease);
  }

  .about__figure:hover .about__img {
    filter: none;
  }

  /* Grades the foot of the portrait into the page so the caption has
     something to sit on and the crop does not end on a hard edge. */
  .about__figure::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 45%;
    pointer-events: none;
    background: linear-gradient(to top, var(--bg) 2%, transparent 92%);
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .about__heading {
    margin-bottom: 0.4rem;
  }

  .about__para {
    color: var(--ink-2);
    max-width: 56ch;
    text-wrap: pretty;
  }

  .about__stack {
    margin: 1.25rem 0 0;
    display: flex;
    flex-direction: column;
  }

  .about__group {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.45rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--line-soft);
  }

  .about__group:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  .about__group-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .about__group-name :global(.icon) {
    color: var(--accent-2);
  }

  .about__group-items {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .about__chip {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-2);
  }

  @media (min-width: 56rem) {
    .about__grid {
      /* Fixed 22rem rather than a fraction, so the portrait is never asked to
         render wider than its source file can sharply fill. */
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: clamp(2.5rem, 6vw, 5rem);
    }

    .about__group {
      grid-template-columns: 8rem 1fr;
      gap: 1.25rem;
      align-items: start;
    }
  }
</style>
