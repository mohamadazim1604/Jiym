---
/**
 * The pointer, rebuilt as an instrument reticle.
 *
 * Three parts, each moving on its own clock, which is the whole trick — a
 * custom cursor that moves as one rigid object reads as a laggy mouse
 * pointer rather than as an interface:
 *
 *   · the DOT tracks the pointer exactly, every frame, no easing. Something
 *     has to be pinned to the real position or the whole thing feels broken.
 *   · the RING chases the dot with easing, and squashes along its direction
 *     of travel in proportion to speed. That inertia is what makes it read as
 *     a physical object being dragged rather than a div being repositioned.
 *   · the TAG only exists over things that declare a label.
 *
 * Pointer devices only, and never under reduced motion: on a touch screen
 * there is no cursor to replace, and hiding the system pointer for someone
 * who has asked for less movement is exactly the wrong trade.
 */
---

<div class="cursor" data-cursor aria-hidden="true">
  {/* Drawn rather than bordered. A plain circle reads as a bubble; the gap in
      the ring and the four ticks around it read as an instrument acquiring
      something, which is the same register as the rest of the page. */}
  <span class="cursor__ring">
    <svg class="cursor__reticle" viewBox="0 0 48 48" fill="none" aria-hidden="true">
      <circle
        cx="24"
        cy="24"
        r="21"
        stroke="currentColor"
        stroke-width="1"
        stroke-dasharray="18 8"
        opacity="0.9"></circle>
      <path d="M24 1v6M24 41v6M1 24h6M41 24h6" stroke="currentColor" stroke-width="1"></path>
    </svg>
  </span>

  <span class="cursor__dot"></span>

  <span class="cursor__tag">
    <span class="cursor__tag-text" data-cursor-text></span>
  </span>
</div>

<script>
  /**
   * Spring physics from `motion` — the framework-agnostic build of Framer
   * Motion, which is why this needs no React.
   *
   * The ring used to chase the pointer on a hand-rolled lerp: a fixed
   * fraction of the remaining distance, every frame. That is cheap and it is
   * also why it felt like a lagging cursor rather than a physical object —
   * a lerp has no momentum, so it decelerates into every stop identically no
   * matter how hard it was thrown. A spring carries velocity through the
   * stop and settles, which is the entire difference between "delayed" and
   * "weighted".
   *
   * `getVelocity()` comes free with the spring, so the squash-and-stretch is
   * now driven by real measured speed rather than by differencing positions
   * by hand.
   */
  import { motionValue, springValue } from 'motion';

  const root = document.querySelector<HTMLElement>('[data-cursor]');

  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (root && fine.matches && !reduced.matches) {
    const ring = root.querySelector<HTMLElement>('.cursor__ring');
    const dot = root.querySelector<HTMLElement>('.cursor__dot');
    const tag = root.querySelector<HTMLElement>('.cursor__tag');
    const text = root.querySelector<HTMLElement>('[data-cursor-text]');

    if (ring && dot && tag && text) {
      /* Only now is the system pointer given up. Set in the markup instead,
         a browser that never ran this script would leave the visitor with no
         pointer at all. */
      document.documentElement.classList.add('has-cursor');

      let px = innerWidth / 2;
      let py = innerHeight / 2;
      let shown = false;

      /* The target the ring is pulled toward, and the spring that does the
         pulling. Low damping relative to stiffness leaves a trace of overshoot
         — enough to feel sprung, not enough to wobble. */
      const tx = motionValue(px);
      const ty = motionValue(py);
      const opts = { stiffness: 380, damping: 30, mass: 0.55 };
      const sx = springValue(tx, opts);
      const sy = springValue(ty, opts);

      addEventListener(
        'pointermove',
        (event) => {
          px = event.clientX;
          py = event.clientY;
          tx.set(px);
          ty.set(py);
          kick();

          if (!shown) {
            shown = true;
            root.classList.add('is-live');
          }
        },
        { passive: true },
      );

      // Leaving the window entirely, or dropping into another frame.
      for (const type of ['pointerout', 'blur'] as const) {
        addEventListener(type, (event) => {
          if (type === 'pointerout' && (event as PointerEvent).relatedTarget) return;
          shown = false;
          root.classList.remove('is-live');
        });
      }

      addEventListener('pointerdown', () => root.classList.add('is-down'));
      addEventListener('pointerup', () => root.classList.remove('is-down'));

      /* What counts as worth reacting to. `[data-cursor-label]` is the opt-in
         for anything that is not already a control — a figure, a card, a
         block of media. */
      const HOT = 'a, button, [data-cursor-label], input, textarea, select, summary';

      addEventListener('pointerover', (event) => {
        const hit = (event.target as HTMLElement)?.closest?.<HTMLElement>(HOT);
        root.classList.toggle('is-hot', Boolean(hit));

        const label = hit?.dataset.cursorLabel ?? '';
        root.classList.toggle('is-tagged', Boolean(label));
        // Only written when it changes: this fires on every element boundary
        // the pointer crosses, and writing the same string back each time is
        // a layout invalidation for nothing.
        if (label && text.textContent !== label) text.textContent = label;
      });

      /* The loop stops itself. The dot only moves when the pointer does, and
         the ring only moves while its spring is still settling — so once both
         are true there is nothing left to draw, and holding a frame callback
         open just to write the same three values back keeps the compositor
         awake and costs battery for no picture at all. `kick` restarts it. */
      let raf = 0;

      const loop = () => {
        // The dot is pinned to the truth. Nothing eased, nothing sprung —
        // something has to sit exactly where the pointer is.
        dot.style.translate = `${px}px ${py}px`;

        const rx = sx.get();
        const ry = sy.get();

        /* Velocity in pixels per SECOND, straight off the spring. Divided
           down to a 0-1 ratio and capped hard: uncapped, one flick across a
           wide monitor turns the reticle into a streak the width of the
           screen. */
        const vx = sx.getVelocity();
        const vy = sy.getVelocity();
        const speed = Math.min(Math.hypot(vx, vy) / 1600, 1);

        ring.style.translate = `${rx}px ${ry}px`;
        /* `rotate` and `scale` as their own properties rather than folded into
           a `transform`: the individual properties compose in a fixed order —
           translate, then rotate, then scale — which is precisely the order
           this needs. Written as one `transform` the stretch would be applied
           in rotated space and drag the ring off the pointer. */
        ring.style.rotate = `${(Math.atan2(vy, vx) * 180) / Math.PI}deg`;
        ring.style.scale = `${1 + speed * 0.42} ${1 - speed * 0.26}`;

        tag.style.translate = `${rx}px ${ry}px`;

        // Still travelling, or still more than half a pixel short of the
        // pointer it is chasing.
        const busy = speed > 0.001 || Math.hypot(px - rx, py - ry) > 0.5;
        raf = busy ? requestAnimationFrame(loop) : 0;
      };

      const kick = () => {
        if (!raf) raf = requestAnimationFrame(loop);
      };

      kick();
    }
  }
</script>

<style>
  /* `display: contents`, and this is the one decision the whole component
     rests on. The dot inverts whatever is beneath it with
     `mix-blend-mode: difference`, and a blend only ever reaches as far as the
     nearest ancestor stacking context. Wrapped in a `position: fixed`
     container — which unconditionally creates one — the dot would blend
     against nothing but its own transparent parent and come out plain white
     everywhere. Dissolving the wrapper's box puts each part directly in the
     root stacking context, where the dot can see the page.

     The wrapper still exists as a selector target, which is how the state
     classes below reach all three parts at once. */
  .cursor {
    display: contents;
  }

  /* Each part is fixed at the origin and moved with the `translate`
     property, so the browser only recomposites — no layout, no paint. The
     negative margins centre each part on the pointer; doing that with a
     `-50%` inside the transform would fight the script for ownership of the
     same property. */
  .cursor__ring,
  .cursor__dot,
  .cursor__tag {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    will-change: translate;
  }

  /* Hidden until the pointer actually moves. Parked at the centre of the
     screen on load, it reads as a stray graphic dropped on the page. */
  .cursor__ring,
  .cursor__dot {
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  .cursor__ring {
    z-index: 200;
    width: 38px;
    height: 38px;
    margin: -19px 0 0 -19px;
    color: var(--accent-type);
    transition:
      width 0.35s var(--ease),
      height 0.35s var(--ease),
      margin 0.35s var(--ease),
      opacity 0.35s var(--ease);
  }

  .cursor.is-live .cursor__ring {
    opacity: 0.85;
  }

  .cursor__reticle {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Inverts what it sits on rather than picking a colour. Over the near-black
     ground it reads white; over the light primary button it goes dark by
     itself. One element, correct on every surface on the page. */
  .cursor__dot {
    z-index: 202;
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    border-radius: 50%;
    background: #fff;
    mix-blend-mode: difference;
    transition:
      width 0.3s var(--ease),
      height 0.3s var(--ease),
      margin 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }

  .cursor.is-live .cursor__dot {
    opacity: 1;
  }

  /* --- states -------------------------------------------------------------- */

  /* Over anything interactive the ring opens up and the dot gets out of the
     way, so the thing being pointed at is framed rather than covered. */
  .cursor.is-live.is-hot .cursor__ring {
    width: 62px;
    height: 62px;
    margin: -31px 0 0 -31px;
    opacity: 1;
  }

  .cursor.is-hot .cursor__dot {
    width: 3px;
    height: 3px;
    margin: -1.5px 0 0 -1.5px;
  }

  .cursor.is-live.is-hot .cursor__dot {
    opacity: 0.5;
  }

  .cursor.is-down .cursor__ring {
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
  }

  .cursor__tag {
    z-index: 201;
    /* Below and right of the reticle, clear of the ring at its widest. */
    margin: 26px 0 0 26px;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--accent-line);
    border-radius: 3px;
    background: color-mix(in srgb, var(--deep) 82%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    opacity: 0;
    scale: 0.85;
    transform-origin: 0 0;
    transition:
      opacity 0.28s var(--ease),
      scale 0.28s var(--ease);
  }

  .cursor.is-live.is-tagged .cursor__tag {
    opacity: 1;
    scale: 1;
  }
</style>

