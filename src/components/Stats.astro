---
import BlockField from './BlockField.astro';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { site } from '../data/site';

/* One glyph per metric, in the order the stats are declared. */
const statGlyphs: IconName[] = ['award', 'blocks', 'clock', 'stack'];
---

{/* Metrics bar. Verifiable numbers, placed before any adjective. */}
<section class="stats has-field" aria-label="At a glance">
  <BlockField variant="scan" />

  <div class="container">
    <ul class="stats__grid">
      {
        site.stats.map((stat, i) => (
          <li class="stats__cell glow lift" style={`--i:${i}`}>
            <span class="stats__bar" aria-hidden="true" />
            <span class="stats__glyph" aria-hidden="true">
              <Icon name={statGlyphs[i] ?? 'stack'} size="1.1rem" />
            </span>

            {/* The rendered text IS the final value, so the number is correct
                with no JavaScript at all. The roll-up only ever overwrites a
                value it has already captured from the markup. */}
            <span class="stats__value">{stat.value}</span>
            <span class="stats__label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>



<style>
  /* Solid. The footage running behind a row of statistics was the single
     worst place for it on the page: numbers are the one thing a visitor
     stops to read carefully, and they were doing it against moving ground. */
  .stats {
    position: relative;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
    border-block: 1px solid var(--line);
    background-color: var(--bg-deep);
  }

  .stats__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1rem);
  }

  /* Solid cards rather than four columns of loose text divided by hairlines.
     Floating on the ambient plate the numbers had nothing to sit on and the
     whole band read as unfinished; given an edge and a ground, each figure
     becomes a plate that can be looked at on its own. */
  .stats__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    overflow: hidden;
    background-color: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
  }

  /* Accent cap along the top edge, drawn in from the left as the card lands. */
  .stats__bar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }

  .stats__cell:hover .stats__bar {
    transform: scaleX(1);
  }

  .stats__glyph {
    position: absolute;
    top: 0.9rem;
    right: 1rem;
    display: grid;
    place-items: center;
    color: var(--accent-2);
    opacity: 0.5;
    transition:
      opacity 0.45s var(--ease),
      transform 0.45s var(--ease);
  }

  .stats__cell:hover .stats__glyph {
    opacity: 1;
    transform: translateY(-2px) scale(1.1);
  }

  /* Mono numerals at display scale. Tabular figures so the row does not jitter
     if a value is ever swapped for a different width. */
  .stats__value {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 2.9rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stats__label {
    font-size: var(--step--1);
    /* Was --muted, which sat too far back for a line this short: these are
       the four claims the whole page rests on and they have to read. */
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (min-width: 52rem) {
    .stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
