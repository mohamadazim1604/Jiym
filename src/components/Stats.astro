---
import BlockField from './BlockField.astro';
import { site } from '../data/site';
---

{/* Metrics bar. Verifiable numbers, placed before any adjective. */}
<section class="stats has-field" aria-label="At a glance">
  <BlockField variant="scan" depth="2rem" />

  <div class="container">
    <ul class="stats__grid">
      {
        site.stats.map((stat, i) => (
          <li class="stats__cell glow lift m-tilt" style={`--i:${i}`}>
            <span class="stats__bar" aria-hidden="true" />
            <span class="stats__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

            {/* The rendered text IS the final value, so the number is correct
                with no JavaScript at all. The roll-up only ever overwrites a
                value it has already captured from the markup. */}
            <span class="stats__value" data-tally>{stat.value}</span>
            <span class="stats__label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  /**
   * Rolls each metric up to its printed value the first time the bar is
   * scrolled into view. Format is inferred from the markup rather than
   * configured: '03' keeps its leading zero, '3.72' keeps two decimals, and
   * '2+' keeps its suffix.
   */
  const cells = document.querySelectorAll<HTMLElement>('[data-tally]');

  if (cells.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const DURATION = 1400;

    const roll = (cell: HTMLElement) => {
      const final = cell.textContent?.trim() ?? '';
      const parts = final.match(/^(\D*)(\d+(?:\.\d+)?)(.*)$/);
      if (!parts) return;

      const [, prefix, digits, suffix] = parts;
      const target = Number(digits);
      if (!Number.isFinite(target)) return;

      const decimals = digits.includes('.') ? digits.split('.')[1].length : 0;
      const width = digits.split('.')[0].length;

      const format = (value: number) =>
        prefix + value.toFixed(decimals).padStart(decimals ? width + decimals + 1 : width, '0') + suffix;

      const start = performance.now();

      const step = (now: number) => {
        const t = Math.min((now - start) / DURATION, 1);
        // Same settle as --ease, so the numbers land with the panels.
        const eased = 1 - Math.pow(1 - t, 4);
        cell.textContent = format(target * eased);
        if (t < 1) requestAnimationFrame(step);
        else cell.textContent = final;
      };

      requestAnimationFrame(step);
    };

    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          roll(entry.target as HTMLElement);
          watcher.unobserve(entry.target);
        }
      },
      { threshold: 0.6 },
    );

    for (const cell of cells) watcher.observe(cell);
  }
</script>

<style>
  /* Solid. The footage running behind a row of statistics was the single
     worst place for it on the page: numbers are the one thing a visitor
     stops to read carefully, and they were doing it against moving ground. */
  .stats {
    position: relative;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
    border-block: 1px solid var(--line);
    background-color: var(--bg-deep);
  }

  .stats__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1rem);
  }

  /* Solid cards rather than four columns of loose text divided by hairlines.
     Floating on the ambient plate the numbers had nothing to sit on and the
     whole band read as unfinished; given an edge and a ground, each figure
     becomes a plate that can be looked at on its own. */
  .stats__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    overflow: hidden;
    background-color: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
  }

  /* Accent cap along the top edge, drawn in from the left as the card lands. */
  .stats__bar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }

  .stats__cell:hover .stats__bar {
    transform: scaleX(1);
  }

  .stats__index {
    position: absolute;
    top: 0.85rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    color: var(--faint);
    opacity: 0.6;
  }

  /* Mono numerals at display scale. Tabular figures so the row does not jitter
     if a value is ever swapped for a different width. */
  .stats__value {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 2.9rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stats__label {
    font-size: var(--step--1);
    /* Was --muted, which sat too far back for a line this short: these are
       the four claims the whole page rests on and they have to read. */
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (min-width: 52rem) {
    .stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
