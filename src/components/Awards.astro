---
import { Image } from 'astro:assets';
import SplitText from './SplitText.astro';
import BlockField from './BlockField.astro';
import Icon from './Icon.astro';
import certBest from '../assets/cert-best-innovation.jpg';
import certGold01 from '../assets/cert-gold-01.jpg';
import certGold02 from '../assets/cert-gold-02.jpg';
import { site } from '../data/site';

/**
 * The certificates, in the same order as the awards list above: the Best
 * Innovation Award first, then the two Golds.
 *
 * Each was lifted straight out of its PDF. Every one of those PDFs is a single
 * scanned page stored as a DCTDecode stream, which is a JPEG verbatim, so the
 * image could be extracted losslessly with no rasteriser in the toolchain.
 * They are shown as documents, not as links: there is nothing to open.
 */
const certificates = [
  { src: certBest, label: 'Best Innovation Award' },
  { src: certGold01, label: 'Gold Award' },
  { src: certGold02, label: 'Gold Award' },
];
---

<section class="section awards has-field" id="awards">
  <BlockField variant="video" src="/media/abstract.mp4" />

  <div class="container">
    <header class="awards__head">
      <p class="section__no" data-no="03">Recognition</p>
      <h2 class="h2">
        <SplitText text="Recognition" />
        <SplitText text="and achievement." offset={1} italic />
      </h2>
      <p class="lede">
        Work delivered at the Malaysia Technology Expo, judged against entries from across the
        region. Listed here with the certificates behind them.
      </p>
    </header>

    <ol class="awards__list">
      {
        site.awards.map((award, i) => (
          <li class="awards__row" style={`--i:${i % 3}`}>
            <span class="awards__k">
              <span class="awards__glyph" data-tier={award.tier}>
                <Icon name="award" size="1.1rem" />
              </span>
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
            </span>

            <div class="awards__main">
              <h3 class:list={['awards__title', { 'is-top': award.tier === 'top' }]}>
                {award.title}
              </h3>
              <p class="awards__prog">{award.programme}</p>
            </div>

            <div class="awards__meta">
              <span class="awards__project">{award.project}</span>
              <span class="awards__event">{award.event}</span>
            </div>

            <span class="awards__rule" aria-hidden="true" />
          </li>
        ))
      }
    </ol>

    <div class="certs">
      <p class="certs__head">Certificates</p>

      <ul class="certs__grid">
        {
          certificates.map((cert) => (
            <li class="certs__item">
              <figure class="certs__figure">
                <Image
                  class="certs__img"
                  src={cert.src}
                  alt={`${cert.label} certificate, Malaysia Technology Expo`}
                  width={620}
                  widths={[300, 460, 620]}
                  sizes="(min-width: 46rem) 30vw, 92vw"
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="certs__meta">
                  <span class="certs__label">{cert.label}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .awards__head {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 48rem;
  }

  .awards__list {
    list-style: none;
    padding: 0;
    margin: clamp(1.75rem, 3.5vw, 2.75rem) 0 0;
  }

  .awards__row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.45rem 1.1rem;
    align-items: baseline;
    padding-block: clamp(1.25rem, 2.5vw, 1.9rem);
    border-top: 1px solid var(--line-soft);
  }

  .awards__row:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  /* The row's own hairline redraws itself in the gradient on hover. */
  .awards__rule {
    position: absolute;
    inset-inline: 0;
    top: -1px;
    height: 1px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }

  .awards__row:hover .awards__rule {
    transform: scaleX(1);
  }

  .awards__k {
    grid-row: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Only the top award's rosette carries the gradient, matching the rule the
     titles already follow: marking all four would mark none. */
  .awards__glyph {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--faint);
    transition:
      color 0.5s var(--ease),
      border-color 0.5s var(--ease),
      transform 0.5s var(--ease);
  }

  .awards__glyph[data-tier='top'] {
    color: var(--accent-2);
    border-color: var(--accent-line);
  }

  .awards__glyph[data-tier='gold'] {
    color: var(--ink-2);
  }

  .awards__row:hover .awards__glyph {
    color: var(--accent-2);
    border-color: var(--accent-line);
    transform: scale(1.08);
  }

  .awards__main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .awards__title {
    font-size: var(--step-3);
  }

  /* The top award is no longer set in the gradient. Blue display type in the
     middle of a list of otherwise white titles read as a mis-styled link
     rather than as emphasis, and the rosette beside it already marks which
     one it is. */
  .awards__title.is-top {
    color: var(--ink);
  }

  .awards__prog {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }

  .awards__meta {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .awards__project {
    font-size: var(--step--1);
    font-weight: 500;
  }

  .awards__event {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* --- certificates -------------------------------------------------------- */

  .certs {
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--line-soft);
  }

  .certs__head {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .certs__grid {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(0.85rem, 2vw, 1.25rem);
  }

  .certs__figure {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    background-color: var(--surface);
    transition:
      border-color 0.5s var(--ease),
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .certs__figure:hover {
    transform: translateY(-4px);
    border-color: var(--accent-line);
    box-shadow:
      0 28px 56px -40px var(--shadow),
      0 0 44px -26px rgba(91, 145, 255, 0.45);
  }

  /* Certificates are documents: shown whole, never cropped. They all share
     one ratio already, so nothing has to be forced to match. */
  .certs__img {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.9) brightness(0.92);
    transition: filter 0.6s var(--ease);
  }

  .certs__figure:hover .certs__img {
    filter: none;
  }

  .certs__meta {
    padding: 0.75rem 0.9rem;
    border-top: 1px solid var(--line-soft);
  }

  .certs__label {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  @media (min-width: 46rem) {
    .certs__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 52rem) {
    .awards__row {
      grid-template-columns: auto 1fr auto;
      gap: 2rem;
    }

    .awards__meta {
      grid-column: 3;
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
