---
import { Image } from 'astro:assets';
import SplitText from './SplitText.astro';
import BlockField from './BlockField.astro';
import Icon from './Icon.astro';
import trophy from '../assets/mte-best-innovation-trophy.jpeg';
import ceremony from '../assets/mte-award-ceremony.jpeg';
import wall from '../assets/mte-award-winners-wall.jpg';
import { site } from '../data/site';

/**
 * Evidence for the list above. A row of award titles is a claim; the trophy
 * with the category engraved on it is the receipt, which is the whole reason
 * these are worth the page weight.
 *
 * Each is shown whole rather than cropped to a shared shape, so a tall
 * trophy shot and a wide group shot simply sit at different heights.
 */
const proof = [
  {
    src: trophy,
    caption: 'Best Innovation Award · IIA',
    alt: 'The International Innovation Awards Best Innovation Award trophy from the 25th Malaysia Technology Expo.',
  },
  {
    src: ceremony,
    caption: 'Gold Award presentation · MTE',
    alt: 'The project team on stage at the Malaysia Technology Expo holding Gold Award certificates and medals.',
  },
  {
    src: wall,
    caption: 'Award winners’ display · MTE',
    alt: 'The Malaysia Technology Expo award winners display wall, with the trophies on plinths.',
  },
];
---

<section class="section awards has-field" id="awards">
  <BlockField variant="rings" depth="3rem" />

  <div class="container">
    <header class="awards__head">
      <p class="section__no m-rise" data-no="03">Recognition</p>
      <h2 class="h2">
        <SplitText text="Judged by people with" />
        <SplitText text="no reason to be kind." offset={4} italic />
      </h2>
      <p class="lede m-rise">
        The Malaysia Technology Expo is the region's largest innovation event. Its International
        Innovation Awards and Public Service Innovation Asia tracks are both judged there.
      </p>
    </header>

    <ol class="awards__list">
      {
        site.awards.map((award, i) => (
          <li class="awards__row m-rise" style={`--i:${i % 3}`}>
            <span class="awards__k">
              <span class="awards__glyph" data-tier={award.tier}>
                <Icon name="award" size="1.1rem" />
              </span>
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
            </span>

            <div class="awards__main">
              <h3 class:list={['awards__title', { 'is-top': award.tier === 'top' }]}>
                {award.title}
              </h3>
              <p class="awards__prog">{award.programme}</p>
            </div>

            <div class="awards__meta">
              <span class="awards__project">{award.project}</span>
              <span class="awards__event">{award.event}</span>
            </div>

            <span class="awards__rule" aria-hidden="true" />
          </li>
        ))
      }
    </ol>

    <ul class="proof">
      {
        proof.map((item, i) => (
          <li class="proof__item m-rise" style={`--i:${i}`}>
            <figure class="proof__figure ticked glow">
              <Image
                class="proof__img"
                src={item.src}
                alt={item.alt}
                widths={[380, 560, 760]}
                sizes="(min-width: 46rem) 30vw, 92vw"
                format="webp"
                quality={80}
                loading="lazy"
                decoding="async"
              />
              <figcaption class="proof__caption">{item.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .awards__head {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 48rem;
  }

  .awards__list {
    list-style: none;
    padding: 0;
    margin: clamp(1.75rem, 3.5vw, 2.75rem) 0 0;
  }

  .awards__row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.45rem 1.1rem;
    align-items: baseline;
    padding-block: clamp(1.25rem, 2.5vw, 1.9rem);
    border-top: 1px solid var(--line-soft);
  }

  .awards__row:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  /* The row's own hairline redraws itself in the gradient on hover. */
  .awards__rule {
    position: absolute;
    inset-inline: 0;
    top: -1px;
    height: 1px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }

  .awards__row:hover .awards__rule {
    transform: scaleX(1);
  }

  .awards__k {
    grid-row: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Only the top award's rosette carries the gradient, matching the rule the
     titles already follow: marking all four would mark none. */
  .awards__glyph {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--faint);
    transition:
      color 0.5s var(--ease),
      border-color 0.5s var(--ease),
      transform 0.5s var(--ease);
  }

  .awards__glyph[data-tier='top'] {
    color: var(--accent-2);
    border-color: var(--accent-line);
  }

  .awards__glyph[data-tier='gold'] {
    color: var(--ink-2);
  }

  .awards__row:hover .awards__glyph {
    color: var(--accent-2);
    border-color: var(--accent-line);
    transform: scale(1.08);
  }

  .awards__main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .awards__title {
    font-size: var(--step-3);
  }

  /* Only the top award gets the gradient. Marking all four would mark none. */
  .awards__title.is-top {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .awards__prog {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }

  .awards__meta {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .awards__project {
    font-size: var(--step--1);
    font-weight: 500;
  }

  .awards__event {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* --- proof gallery ------------------------------------------------------ */

  .proof {
    list-style: none;
    padding: 0;
    margin: clamp(1.75rem, 3.5vw, 2.75rem) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(0.85rem, 2vw, 1.25rem);
  }

  /* Every photograph is shown whole, at its own aspect ratio.
     The previous version forced each one into a fixed grid cell with
     `object-fit: cover` and scaled it on hover, which cropped hard into the
     middle of the frame and blew the pixels up past their source resolution —
     that zoomed, soft, jagged look. Nothing here crops or magnifies now:
     the figure takes the shape of its picture, and the picture is only ever
     rendered smaller than the file it came from. */
  .proof__figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    background-color: var(--surface);
    transition:
      border-color 0.55s var(--ease),
      transform 0.55s var(--ease),
      box-shadow 0.55s var(--ease);
  }

  .proof__figure:hover {
    transform: translateY(-5px);
    border-color: var(--accent-line);
    box-shadow:
      0 30px 60px -40px var(--shadow),
      0 0 50px -26px rgba(91, 145, 255, 0.5);
  }

  .proof__img {
    display: block;
    width: 100%;
    /* Intrinsic. No aspect-ratio, no object-fit, no crop. */
    height: auto;
    /* Only a light hold-back: these are bright daylight photographs on a
       near-black page. Heavier grading was reading as muddy rather than as
       part of the palette. */
    filter: saturate(0.86) brightness(0.94);
    transition: filter 0.7s var(--ease);
  }

  .proof__figure:hover .proof__img {
    filter: none;
  }

  .proof__caption {
    display: block;
    padding: 0.75rem 0.9rem 0.85rem;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  @media (min-width: 46rem) {
    /* Three columns of equal width, each item hugging the top of its cell so
       differing picture heights simply stagger instead of being stretched to
       match one another. */
    .proof {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
  }

  @media (min-width: 52rem) {
    .awards__row {
      grid-template-columns: auto 1fr auto;
      gap: 2rem;
    }

    .awards__meta {
      grid-column: 3;
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
