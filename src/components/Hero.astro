---
import SplitText from "./SplitText.astro";
import BlockField from "./BlockField.astro";
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";
import { site, whatsappHref } from "../data/site";

// Mono readouts in the side panel. Everything here is verifiable.
const readouts: { k: string; v: string; icon: IconName }[] = [
  { k: "ROLE", v: site.role, icon: "terminal" },
  { k: "BASE", v: "Kuala Lumpur, MY", icon: "pin" },
  { k: "STACK", v: ".NET Core · Angular", icon: "stack" },
  { k: "AWARDS", v: "3 · Malaysia Technology Expo", icon: "award" },
];

/* Three claims a client can check, sat directly under the buttons. The hero
   otherwise asks for a decision with nothing but adjectives behind it. */
const proof: { label: string; icon: IconName }[] = [
  { label: "3+ years in production", icon: "clock" },
  { label: "3 national innovation awards", icon: "award" },
  { label: "Direct communication and service", icon: "handover" },
];
---

<section class="hero has-field" id="home">
  <BlockField variant="beam" />

  <div class="container hero__inner">
    <div class="hero__head">
      <p class="eyebrow rise rise-1">Full-stack development · Available for new projects</p>

      {
        /* Each clause is its own block, so the two lines break where the
          sentence breaks instead of wherever the column happens to run out. */
      }
      {
        /* Letter split, not word split. The headline is the one place on the
          page where the extra granularity pays for itself: the cascade reads
          as the line being SET rather than as two boxes sliding in, and it
          gives the gleam something to travel along afterwards.
          `offset` on the second clause is the letter count of the first, so
          the stagger runs on as one continuous cascade across both lines. */
      }
      <h1 class="display hero__title" data-kinetic="idle">
        <span class="hero__line">
          <SplitText text="Digital infrastructure" mode="load" delay={220} chars />
        </span>
        <span class="hero__line">
          <SplitText
            text="your business runs on."
            mode="load"
            delay={220}
            offset={21}
            chars
            italic
          />
        </span>
      </h1>

      <span class="hero__rule rise rise-3" aria-hidden="true"></span>
    </div>

    <div class="hero__main">
      <p class="lede hero__lede rise rise-4">
        Web platforms, mobile applications and e-commerce, with the integrations that hold
        them together. Delivered end to end, documented, and supported long after launch.
      </p>

      <div class="hero__actions rise rise-5">
        <a class="btn magnetic" href={whatsappHref} target="_blank" rel="noopener">
          Start a project
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost magnetic" href="#systems">See the work</a>
      </div>

      <ul class="hero__proof rise rise-5">
        {
          proof.map((item, i) => (
            <li class="hero__proof-item" style={`--i:${i}`}>
              <Icon name={item.icon} size="0.95rem" />
              {item.label}
            </li>
          ))
        }
      </ul>
    </div>

    {
      /* Instrument panel. Mono readouts, and nothing sweeping across them:
        the light bar that used to run down this panel was the one piece of
        motion on the page competing with the headline beside it.
        On desktop it spans both rows of the grid so its head sits level with
        the eyebrow — parked beside the lede instead, it left the whole
        top-right of the block empty and read as though it had slipped. */
    }
    <aside
      class="hero__panel ticked glow lift rise rise-3"
      aria-label="At a glance"
    >
      <div class="hero__panel-head">
        <span class="hero__panel-title">Recent Experience</span>
      </div>

      <dl class="hero__readouts">
        {
          readouts.map((row) => (
            <div class="hero__row">
              <dt class="hero__k">
                <Icon name={row.icon} size="0.85rem" />
                {row.k}
              </dt>
              <dd class="hero__v">{row.v}</dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__panel-foot">
        <span class="hero__avail">{site.availableFrom}</span>
      </div>
    </aside>
  </div>
</section>

<script>
  /**
   * Kinetic headline.
   *
   * The letters are already split and animated by CSS; this adds the one
   * thing CSS cannot do on its own, which is let the type answer the pointer.
   * Each letter is given a `--pull` between 0 and 1 for how close the cursor
   * is to it, and global.css decides what a pull is worth in lift and scale.
   *
   * It deliberately does NOT start until the entrance cascade has finished.
   * A running animation outranks every normal declaration, so until `char-in`
   * releases `transform` there is nothing for a pull to move.
   */
  const title = document.querySelector<HTMLElement>('[data-kinetic]');

  if (title) {
    const letters = [...title.querySelectorAll<HTMLElement>('.split__i')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const fine = matchMedia('(hover: hover) and (pointer: fine)');

    /** Distance at which a letter stops noticing the cursor at all. */
    const REACH = 150;

    // Centres, cached relative to the headline box rather than to the
    // viewport, so scrolling never invalidates them. One box read per frame
    // is then enough to place all forty.
    let spots: { x: number; y: number }[] = [];
    let pulls: number[] = letters.map(() => 0);

    const measure = () => {
      const box = title.getBoundingClientRect();
      spots = letters.map((letter) => {
        const rect = letter.getBoundingClientRect();
        return {
          x: rect.left - box.left + rect.width / 2,
          y: rect.top - box.top + rect.height / 2,
        };
      });
    };

    let queued = false;
    let point: { x: number; y: number } | null = null;

    const flush = () => {
      queued = false;
      const box = title.getBoundingClientRect();

      letters.forEach((letter, i) => {
        let pull = 0;

        if (point) {
          const dx = point.x - (box.left + spots[i].x);
          const dy = point.y - (box.top + spots[i].y);
          const near = 1 - Math.min(1, Math.hypot(dx, dy) / REACH);
          // Smoothstep. A linear falloff puts a visible cone edge on the
          // line where letters stop reacting; this rounds both ends of it.
          pull = near * near * (3 - 2 * near);
        }

        // Style writes are the expensive half of this, so only the letters
        // that actually moved this frame are written to.
        if (Math.abs(pull - pulls[i]) < 0.01) return;
        pulls[i] = pull;
        letter.style.setProperty('--pull', pull.toFixed(3));
      });
    };

    const request = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(flush);
    };

    const attach = () => {
      // The whole head block, not the h1: bound to the headline alone the
      // effect cuts out the instant the cursor leaves the text's own box,
      // which is a hard edge in the middle of a soft effect.
      const host = title.closest<HTMLElement>('.hero__head') ?? title;

      measure();
      addEventListener('resize', measure);

      host.addEventListener('pointermove', (event) => {
        point = { x: event.clientX, y: event.clientY };
        request();
      });

      host.addEventListener('pointerleave', () => {
        point = null;
        request();
      });
    };

    const goLive = () => {
      if (title.dataset.kinetic === 'live') return;
      title.dataset.kinetic = 'live';
      attach();
    };

    if (reduced.matches || !fine.matches) {
      // Nothing to hand over to. Under reduced motion the cascade never runs
      // in the first place, and on a touch screen there is no hover to drive
      // a pull — a headline left lifted wherever the last tap landed reads as
      // broken rather than as responsive.
    } else {
      const last = letters[letters.length - 1];

      last?.addEventListener('animationend', (event) => {
        if ((event as AnimationEvent).animationName === 'char-in') goLive();
      });

      // Belt and braces: if the cascade is interrupted — a background tab
      // through the whole of it, a browser that never fires the event — the
      // headline still goes live rather than staying inert forever.
      setTimeout(goLive, 4000);
    }
  }
</script>

<style>
  .hero {
    /* Tight at the top. The sticky header already puts 4.25rem of air above
       this block, so a 10vw pad on top of it opened a dead band the width of
       a phone screen before the first word. */
    padding-block: clamp(1.5rem, 3vw, 2.75rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero__title {
    margin-top: clamp(1.1rem, 2.5vw, 1.75rem);
  }

  /* Blocks, so each clause owns its own line at any width the clause fits.
     Deliberately NOT `nowrap`: forcing it would hold the two lines together
     on a phone by pushing the headline straight off the side of the screen.
     On narrow viewports a clause is allowed to wrap within itself, and the
     inherited `balance` evens out the rag when it does. */
  .hero__line {
    display: block;
  }

  .hero__rule {
    display: block;
    height: 1px;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    background: linear-gradient(
      to right,
      var(--accent),
      var(--accent-2) 22%,
      transparent 70%
    );
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 2.75rem);
    align-items: start;
  }

  .hero__main {
    display: flex;
    flex-direction: column;
  }

  .hero__lede {
    max-width: 52ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* --- proof chips --------------------------------------------------------- */

  .hero__proof {
    list-style: none;
    padding: 0;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .hero__proof-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    background-color: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--ink-2);
    transition:
      border-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  .hero__proof-item :global(.icon) {
    color: var(--accent-2);
  }

  .hero__proof-item:hover {
    border-color: var(--accent-line);
    color: var(--ink);
  }

  /* --- instrument panel --------------------------------------------------- */
  /* Solid, not glass. Letting the footage through was costing the readouts
     their contrast and giving the panel a moving ground to sit on, which is
     the opposite of what an instrument reading should feel like. */
  .hero__panel {
    position: relative;
    overflow: hidden;
    /* `background-color`, not the `background` shorthand: the shorthand would
       reset the pointer lamp that `.glow` paints as a background IMAGE. */
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .hero__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .hero__panel-title {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .hero__readouts {
    margin: 0;
    padding-block: 0.35rem;
  }

  .hero__row {
    display: grid;
    /* Just wide enough for the glyph plus the longest key, so the value
       column keeps enough room to set "Full-Stack Developer" on one line. */
    grid-template-columns: 6.25rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line-soft);
    transition: border-color 0.4s var(--ease);
  }

  .hero__row:hover {
    border-bottom-color: var(--accent-line);
  }

  .hero__row:hover .hero__v {
    color: var(--accent);
  }

  .hero__k {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .hero__k :global(.icon) {
    color: var(--accent-2);
    opacity: 0.75;
  }

  .hero__v {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-2);
    transition: color 0.4s var(--ease);
  }

  .hero__panel-foot {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 1rem;
  }

  .hero__avail {
    font-size: var(--step--1);
    font-weight: 500;
  }

  @media (min-width: 62rem) {
    .hero__inner {
      /* A capped right column rather than a fraction: the panel only needs
         enough width to set its readouts, and every pixel beyond that is
         taken straight out of the headline's measure. */
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 20rem);
      column-gap: clamp(1.75rem, 3vw, 2.5rem);
      row-gap: clamp(1.75rem, 4vw, 2.75rem);
    }

    .hero__head {
      grid-column: 1;
      grid-row: 1;
    }

    .hero__main {
      grid-column: 1;
      grid-row: 2;
    }

    /* Spans both rows and sticks to the top, so its head lines up with the
       eyebrow and the block has no empty corner. */
    .hero__panel {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
    }
  }
</style>
