---
import SplitText from "./SplitText.astro";
import BlockField from "./BlockField.astro";
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";
import { site, whatsappHref } from "../data/site";

// Mono readouts in the side panel. Everything here is verifiable.
const readouts: { k: string; v: string; icon: IconName }[] = [
  { k: "ROLE", v: site.role, icon: "terminal" },
  { k: "BASE", v: "Kuala Lumpur, MY", icon: "pin" },
  { k: "STACK", v: ".NET Core · Angular", icon: "stack" },
  { k: "AWARDS", v: "3 · Malaysia Technology Expo", icon: "award" },
];

/* Three claims a client can check, sat directly under the buttons. The hero
   otherwise asks for a decision with nothing but adjectives behind it. */
const proof: { label: string; icon: IconName }[] = [
  { label: "3+ years in production", icon: "clock" },
  { label: "3 national innovation awards", icon: "award" },
  { label: "Direct communication and service", icon: "handover" },
];
---

<section class="hero has-field" id="home">
  <BlockField variant="beam" />

  <div class="container hero__inner">
    <div class="hero__head">
      <p class="eyebrow rise rise-1">Full-stack development · Available for new projects</p>

      {
        /* Each clause is its own block, so the two lines break where the
          sentence breaks instead of wherever the column happens to run out. */
      }
      {
        /* Letter split, not word split. The headline is the one place on the
          page where the extra granularity pays for itself: the cascade reads
          as the line being SET rather than as two boxes sliding in, and it
          gives the gleam something to travel along afterwards.
          `offset` on the second clause is the letter count of the first, so
          the stagger runs on as one continuous cascade across both lines. */
      }
      <h1 class="display hero__title">
        <span class="hero__line">
          <SplitText text="Digital infrastructure" mode="load" delay={220} chars />
        </span>
        <span class="hero__line">
          <SplitText
            text="your business runs on."
            mode="load"
            delay={220}
            offset={21}
            chars
            italic
          />
        </span>
      </h1>

      <span class="hero__rule rise rise-3" aria-hidden="true"></span>
    </div>

    <div class="hero__main">
      <p class="lede hero__lede rise rise-4">
        Web platforms, mobile applications and e-commerce, with the integrations that hold
        them together. Delivered end to end, documented, and supported long after launch.
      </p>

      <div class="hero__actions rise rise-5">
        <a class="btn magnetic" href={whatsappHref} target="_blank" rel="noopener">
          Start a project
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost magnetic" href="#systems">See the work</a>
      </div>

      <ul class="hero__proof rise rise-5">
        {
          proof.map((item, i) => (
            <li class="hero__proof-item" style={`--i:${i}`}>
              <Icon name={item.icon} size="0.95rem" />
              {item.label}
            </li>
          ))
        }
      </ul>
    </div>

    {
      /* Instrument panel. Mono readouts behind a live scanline, which is what
        makes the corner of the page feel powered rather than decorated.
        On desktop it spans both rows of the grid so its head sits level with
        the eyebrow — parked beside the lede instead, it left the whole
        top-right of the block empty and read as though it had slipped. */
    }
    <aside
      class="hero__panel ticked glow lift rise rise-3"
      aria-label="At a glance"
    >
      <span class="scanline" aria-hidden="true"></span>

      <div class="hero__panel-head">
        <span class="hero__panel-title">Recent Experience</span>
      </div>

      <dl class="hero__readouts">
        {
          readouts.map((row) => (
            <div class="hero__row">
              <dt class="hero__k">
                <Icon name={row.icon} size="0.85rem" />
                {row.k}
              </dt>
              <dd class="hero__v">{row.v}</dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__panel-foot">
        <span class="hero__avail">{site.availableFrom}</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    /* Tight at the top. The sticky header already puts 4.25rem of air above
       this block, so a 10vw pad on top of it opened a dead band the width of
       a phone screen before the first word. */
    padding-block: clamp(1.5rem, 3vw, 2.75rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero__title {
    margin-top: clamp(1.1rem, 2.5vw, 1.75rem);
  }

  /* Blocks, so each clause owns its own line at any width the clause fits.
     Deliberately NOT `nowrap`: forcing it would hold the two lines together
     on a phone by pushing the headline straight off the side of the screen.
     On narrow viewports a clause is allowed to wrap within itself, and the
     inherited `balance` evens out the rag when it does. */
  .hero__line {
    display: block;
  }

  .hero__rule {
    display: block;
    height: 1px;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    background: linear-gradient(
      to right,
      var(--accent),
      var(--accent-2) 22%,
      transparent 70%
    );
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 2.75rem);
    align-items: start;
  }

  .hero__main {
    display: flex;
    flex-direction: column;
  }

  .hero__lede {
    max-width: 52ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* --- proof chips --------------------------------------------------------- */

  .hero__proof {
    list-style: none;
    padding: 0;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .hero__proof-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    background-color: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--ink-2);
    transition:
      border-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  .hero__proof-item :global(.icon) {
    color: var(--accent-2);
  }

  .hero__proof-item:hover {
    border-color: var(--accent-line);
    color: var(--ink);
  }

  /* --- instrument panel --------------------------------------------------- */
  /* Solid, not glass. Letting the footage through was costing the readouts
     their contrast and giving the panel a moving ground to sit on, which is
     the opposite of what an instrument reading should feel like. */
  .hero__panel {
    position: relative;
    overflow: hidden;
    /* `background-color`, not the `background` shorthand: the shorthand would
       reset the pointer lamp that `.glow` paints as a background IMAGE. */
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .hero__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .hero__panel-title {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .hero__readouts {
    margin: 0;
    padding-block: 0.35rem;
  }

  .hero__row {
    display: grid;
    /* Just wide enough for the glyph plus the longest key, so the value
       column keeps enough room to set "Full-Stack Developer" on one line. */
    grid-template-columns: 6.25rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line-soft);
    transition: border-color 0.4s var(--ease);
  }

  .hero__row:hover {
    border-bottom-color: var(--accent-line);
  }

  .hero__row:hover .hero__v {
    color: var(--accent);
  }

  .hero__k {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .hero__k :global(.icon) {
    color: var(--accent-2);
    opacity: 0.75;
  }

  .hero__v {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-2);
    transition: color 0.4s var(--ease);
  }

  .hero__panel-foot {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 1rem;
  }

  .hero__avail {
    font-size: var(--step--1);
    font-weight: 500;
  }

  @media (min-width: 62rem) {
    .hero__inner {
      /* A capped right column rather than a fraction: the panel only needs
         enough width to set its readouts, and every pixel beyond that is
         taken straight out of the headline's measure. */
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 20rem);
      column-gap: clamp(1.75rem, 3vw, 2.5rem);
      row-gap: clamp(1.75rem, 4vw, 2.75rem);
    }

    .hero__head {
      grid-column: 1;
      grid-row: 1;
    }

    .hero__main {
      grid-column: 1;
      grid-row: 2;
    }

    /* Spans both rows and sticks to the top, so its head lines up with the
       eyebrow and the block has no empty corner. */
    .hero__panel {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
    }
  }
</style>
