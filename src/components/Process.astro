---
import SplitText from './SplitText.astro';
import BlockField from './BlockField.astro';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { site } from '../data/site';

/* One glyph per stage, in order: the schema, the slice taken through it, the
   shipped increments, the signed-off handover. */
const stageGlyphs: IconName[] = ['model', 'slice', 'blocks', 'handover'];
---

{/* Parallax is off here: the cards inside are sticky, and a backdrop moving
    at a second rate behind a pinned card just reads as drift. */}
<section class="section section--alt proc has-field" id="process">
  <BlockField variant="aurora" parallax={false} />

  <div class="container">
    <header class="proc__head">
      <p class="section__no m-rise" data-no="04">How it runs</p>
      <h2 class="h2">
        <SplitText text="No silence," />
        <SplitText text="no surprise invoices." offset={2} italic />
      </h2>
      <p class="lede m-rise">
        The two things anyone is actually afraid of when they hire a developer they have not worked
        with before. Each stage removes one of them.
      </p>
    </header>

    {/* Sticky pile-up. Each step parks under the header and the next slides
        over it, so the sequence is felt rather than read. Pure position:
        sticky, no scroll listener. */}
    <ol class="proc__stack">
      {
        site.process.map((step, i) => (
          <li class="proc__item" style={`--i:${i}`}>
            <article class="proc__card m-blur ticked glow">
              <div class="proc__num">
                <span class="proc__glyph">
                  <Icon name={stageGlyphs[i] ?? 'blocks'} size="1.25rem" />
                </span>
                <span class="index">{String(i + 1).padStart(2, '0')}</span>
                <span class="proc__slash" aria-hidden="true">
                  /
                </span>
                <span class="proc__total">{String(site.process.length).padStart(2, '0')}</span>
              </div>

              <div class="proc__body">
                <h3 class="proc__title">{step.title}</h3>
                <p class="proc__text">{step.body}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proc__head {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 46rem;
  }

  .proc__stack {
    list-style: none;
    padding: 0;
    margin: clamp(1.75rem, 3.5vw, 2.75rem) 0 0;
  }

  .proc__item {
    position: sticky;
    /* Each card parks slightly lower than the one before, so the pile shows
       its own edges like a stack rather than one flat surface. */
    top: calc(6rem + var(--i) * 1.15rem);
    padding-bottom: clamp(0.85rem, 2vw, 1.25rem);
  }

  .proc__card {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    min-height: clamp(13rem, 24vw, 16rem);
    align-content: center;
    /* Solid. These cards physically stack on top of one another as you
       scroll, and translucent layers piling up turned the text of the card
       underneath into noise behind the card on top. */
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 -20px 50px -30px var(--shadow);
  }

  .proc__num {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .proc__glyph {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--accent-2);
    transition:
      color 0.45s var(--ease),
      border-color 0.45s var(--ease);
  }

  .proc__card:hover .proc__glyph {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  .proc__slash,
  .proc__total {
    color: var(--faint);
  }

  .proc__body {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .proc__title {
    font-size: var(--step-3);
  }

  .proc__text {
    color: var(--muted);
    max-width: 54ch;
    text-wrap: pretty;
  }

  /* The last card inverts, so the sequence resolves rather than just stopping,
     and it hands off to the dark contact block below. */
  .proc__item:last-child .proc__card {
    background-color: var(--deep);
    border-color: var(--accent-line);
    color: var(--deep-text);
  }

  .proc__item:last-child .proc__text {
    color: var(--deep-muted);
  }

  .proc__item:last-child .proc__slash,
  .proc__item:last-child .proc__total {
    color: var(--deep-muted);
  }

  @media (min-width: 46rem) {
    .proc__card {
      grid-template-columns: auto 1fr;
      align-items: start;
    }
  }
</style>
