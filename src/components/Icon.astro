---
/**
 * Inline SVG icon set.
 *
 * Deliberately not an icon library. The page needs about fifteen glyphs, and
 * every icon package either ships a runtime, a font file, or a sprite request
 * to buy that. These are inlined into the markup at build time: no request,
 * no layout shift, no dependency, and they inherit `currentColor` so they
 * pick up the accent, the muted grey, or the gradient wherever they land.
 *
 * Drawn on one 24x24 grid at a 1.5 stroke with round joins, which is what
 * keeps a rosette and a database glyph looking like they came from the same
 * hand. Anything filled or multi-weight would break that.
 */
export type IconName =
  | 'trace'
  | 'stock'
  | 'transaction'
  | 'booking'
  | 'mobile'
  | 'cart'
  | 'award'
  | 'model'
  | 'slice'
  | 'blocks'
  | 'handover'
  | 'whatsapp'
  | 'mail'
  | 'github'
  | 'linkedin'
  | 'pin'
  | 'clock'
  | 'stack'
  | 'terminal'
  | 'play'
  | 'arrow';

interface Props {
  name: IconName;
  /** Any CSS length. Defaults to 1em so the glyph tracks its text. */
  size?: string;
  class?: string;
  /**
   * Icons here are decorative by default: they sit beside a label that
   * already says the same thing, so announcing them would just repeat it.
   * Pass a label only when the icon is the ONLY thing carrying the meaning.
   */
  label?: string;
}

const { name, size = '1em', class: className = '', label } = Astro.props;

/** Path geometry only. Every glyph is stroked, none are filled. */
const paths: Record<IconName, string> = {
  // Chain of custody: three linked nodes on a route.
  trace:
    'M5 6.5h4.5a3 3 0 0 1 0 6H8a3 3 0 0 0 0 6h4.5M17.5 4.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM6.5 15.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM17.5 15.5v3.5M15.75 17.25h3.5',
  // Bins and lots: a stacked container.
  stock: 'M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5v-9ZM3.5 7.5 12 12m0 0 8.5-4.5M12 12v9',
  // Purchase, processing, sale: a two-way ledger movement.
  transaction: 'M4 8h13l-3-3m6 11H7l3 3M4 8l3-3M20 16l-3 3',
  // Scheduling with a confirmed slot.
  booking: 'M4 6.5h16v13H4v-13ZM4 10.5h16M8 3.5v4M16 3.5v4m-6.5 8 2 2 4-4',
  // A handset, for work that ships to a phone.
  mobile:
    'M7.5 3h9a1.5 1.5 0 0 1 1.5 1.5v15a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 19.5v-15A1.5 1.5 0 0 1 7.5 3Zm2.75 14.5h3.5',
  // A basket on wheels, for anything that takes a payment.
  cart: 'M3 4.5h2.3l2.2 10h9.3l2.2-7.5H6.6M9.75 20a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5Zm7 0a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5Z',
  // Recognition: a rosette.
  award: 'M12 3.5a5.25 5.25 0 1 0 0 10.5 5.25 5.25 0 0 0 0-10.5ZM8.75 13.25 7.5 20.5l4.5-2.25 4.5 2.25-1.25-7.25',
  // Model first: the schema itself.
  model:
    'M12 3.5c3.87 0 7 1.12 7 2.5s-3.13 2.5-7 2.5-7-1.12-7-2.5 3.13-2.5 7-2.5ZM5 6v12c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5V6M5 12c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5',
  // Thin slice: one layer taken through the whole stack.
  slice: 'M3.5 8.5 12 4l8.5 4.5L12 13 3.5 8.5ZM3.5 15.5 12 20l8.5-4.5M7 10.75 15.5 6.25',
  // Build in blocks: shipped increments.
  blocks: 'M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z',
  // Handover: it is signed off and yours.
  handover: 'M4 12.5V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7M3 17l2.5 2.5L10 15',
  whatsapp:
    'M3.75 20.25 5 16.4A7.75 7.75 0 1 1 7.9 19.2l-4.15 1.05ZM9 8.5c-.3 0-.6.1-.8.35-.3.3-.85.85-.85 2s.85 2.3 1 2.45c.1.2 1.65 2.65 4.1 3.6 2.05.8 2.45.65 2.9.6.45-.05 1.45-.6 1.65-1.15.2-.6.2-1.1.15-1.2-.05-.1-.2-.15-.45-.3-.25-.1-1.45-.7-1.65-.8-.25-.1-.4-.1-.55.1-.15.25-.6.8-.75.95-.15.2-.3.2-.55.1-.25-.15-1.05-.4-2-1.25-.75-.65-1.2-1.45-1.35-1.7-.15-.25 0-.4.1-.5.1-.1.25-.3.35-.45.15-.15.2-.25.3-.45.1-.15.05-.3 0-.45-.05-.1-.55-1.3-.75-1.8-.2-.45-.4-.4-.55-.4H9Z',
  mail: 'M3.5 6.5h17v11h-17v-11Zm0 .5 8.5 6 8.5-6',
  github:
    'M9.25 20.5v-2.9c0-.85.25-1.4.6-1.7-2.85-.35-5.35-1.45-5.35-6a4.7 4.7 0 0 1 1.25-3.25 4.35 4.35 0 0 1 .1-3.2s1-.3 3.35 1.25a11.4 11.4 0 0 1 6 0C17.55 3.25 18.55 3.55 18.55 3.55a4.35 4.35 0 0 1 .1 3.2A4.7 4.7 0 0 1 19.9 10c0 4.55-2.5 5.65-5.35 6 .4.35.75 1 .75 2v3.5M9.25 18.5c-2.5.75-3.5-.5-4-1.25',
  linkedin: 'M4.5 9.5h3v11h-3v-11Zm0-5.25h3v3h-3v-3ZM10.5 20.5v-11h3v1.5a3.6 3.6 0 0 1 3.25-1.75c2.35 0 3.75 1.5 3.75 4.25v7h-3v-6.4c0-1.5-.6-2.35-1.9-2.35-1.35 0-2.1.9-2.1 2.35v6.4h-3Z',
  pin: 'M12 21s6.5-5.4 6.5-10a6.5 6.5 0 1 0-13 0c0 4.6 6.5 10 6.5 10ZM12 13.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  clock: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM12 7.5V12l3 2',
  stack: 'M3.5 12 12 16.5l8.5-4.5M3.5 16 12 20.5l8.5-4.5M3.5 8 12 3.5 20.5 8 12 12.5 3.5 8Z',
  terminal: 'M3.5 4.5h17v15h-17v-15ZM7 9.5l2.5 2.5L7 14.5M12.5 15h4.5',
  play: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM10.25 8.75l5.25 3.25-5.25 3.25v-6.5Z',
  arrow: 'M4.5 12h15m-6-6 6 6-6 6',
};

const decorative = label === undefined;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={label}
  focusable="false"
>
  {label && <title>{label}</title>}
  <path d={paths[name]}></path>
</svg>

<style>
  .icon {
    /* Sits on the text baseline instead of the line box, so a glyph beside a
       label lines up with the label rather than riding above it. */
    display: inline-block;
    vertical-align: -0.135em;
    flex: none;
    overflow: visible;
  }
</style>
