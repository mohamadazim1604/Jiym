---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import SplitText from './SplitText.astro';
import { site, mailtoHref, whatsappHref } from '../data/site';

/* Social platforms are one of the few places a logo genuinely carries more
   than its label does, so these are the real marks rather than a generic
   link glyph. Anything unrecognised falls back to the arrow. */
const socialGlyphs: Record<string, IconName> = {
  GitHub: 'github',
  LinkedIn: 'linkedin',
};

const year = new Date().getFullYear();

const links = [
  { label: 'Systems', href: '/#systems' },
  { label: 'Capabilities', href: '/#capabilities' },
  { label: 'Recognition', href: '/#awards' },
  { label: 'About', href: '/#about' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <p class="footer__name">{site.name}</p>
        <p class="footer__role">{site.role}</p>
        <p class="footer__loc">{site.location}</p>
      </div>

      <nav class="footer__col" aria-label="Footer">
        <p class="footer__head">Sections</p>
        {links.map((link) => <a class="footer__link" href={link.href}>{link.label}</a>)}
      </nav>

      <div class="footer__col">
        <p class="footer__head">Contact</p>
        <a class="footer__link" href={mailtoHref}>
          <Icon name="mail" size="0.95rem" />
          {site.email}
        </a>
        <a class="footer__link" href={whatsappHref} target="_blank" rel="noopener">
          <Icon name="whatsapp" size="0.95rem" />
          {site.phoneDisplay}
        </a>
        <span class="footer__link footer__link--static">
          <Icon name="pin" size="0.95rem" />
          {site.location}
        </span>
      </div>

      <div class="footer__col">
        <p class="footer__head">Elsewhere</p>
        {
          site.socials.map((social) => (
            <a class="footer__link" href={social.href} target="_blank" rel="noopener">
              <Icon name={socialGlyphs[social.label] ?? 'arrow'} size="0.95rem" />
              {social.label}
            </a>
          ))
        }
      </div>
    </div>

    {/* The wordmark, at the size the page can finally afford to set it.
        A footer that simply stops is the most common way a portfolio throws
        away its last impression; this gives the scroll somewhere to land.

        Outlined rather than filled, because at this size solid type would
        outshout the contact details directly above it — the name should be
        the last thing you notice, not the first.

        `aria-hidden`, and deliberately: the name is already announced by
        `.footer__name` a few lines up, and a screen reader hearing it twice
        gains nothing but the confusion of wondering which one matters. */}
    <div class="footer__mark" aria-hidden="true">
      <SplitText text={site.name.toUpperCase()} chars />
    </div>

    <div class="footer__base">
      <p class="footer__fine">© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line-soft);
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.75rem;
    background-color: color-mix(in srgb, var(--surface) 72%, transparent);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: clamp(2rem, 5vw, 3rem);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .footer__role,
  .footer__loc {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .footer__head {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 0.3rem;
  }

  .footer__link {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--step--1);
    color: var(--ink-2);
    transition: color 0.3s var(--ease);
  }

  .footer__link :global(.icon) {
    color: var(--faint);
    transition: color 0.3s var(--ease);
  }

  a.footer__link:hover {
    color: var(--accent);
  }

  a.footer__link:hover :global(.icon) {
    color: var(--accent-2);
  }

  .footer__link--static {
    cursor: default;
    color: var(--muted);
  }

  /* Centred, now that the colophon line beside it is gone. Left-aligning a
     single line under a four-column grid just looked like the other half had
     failed to render. */

  /* --- wordmark ----------------------------------------------------------- */

  .footer__mark {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    /* The letters are inline-blocks that lean and lift, so they need room
       above the line box or the tops get clipped by the base rule. */
    padding-bottom: 0.08em;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 12.2vw, 9.5rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.045em;
    /* Outlined, not filled. The stroke is the same hairline every rule and
       border on this page is drawn in, so the name reads as part of the
       instrument rather than as a headline that wandered into the footer. */
    color: transparent;
    -webkit-text-stroke: 1px var(--line-hard);
    text-stroke: 1px var(--line-hard);
    user-select: none;
  }

  /* Fills as the pointer crosses it, letter by letter — the one place on the
     page where the wordmark is allowed to become solid. `transition-delay`
     off `--i` means the fill chases the cursor across the name instead of
     switching the whole thing at once. */
  .footer__mark :global(.split__i) {
    transition:
      color 0.5s var(--ease),
      -webkit-text-stroke-color 0.5s var(--ease);
  }

  .footer__mark:hover :global(.split__i) {
    color: var(--accent-type);
    -webkit-text-stroke-color: transparent;
    transition-delay: calc(var(--i, 0) * 28ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__mark:hover :global(.split__i) {
      transition-delay: 0ms;
    }
  }

  .footer__base {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-soft);
  }

  .footer__fine {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--faint);
    text-align: center;
  }
</style>
