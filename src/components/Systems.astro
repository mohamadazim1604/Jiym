---
import { getCollection } from 'astro:content';
import SplitText from './SplitText.astro';
import BlockField from './BlockField.astro';

const entries = (await getCollection('work'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

/*
 * The media column is deliberately empty for now — real screenshots of each
 * system are coming, and a generated plate standing in for them was doing
 * more harm than good. Until then each system is set as a typographic record
 * across the full measure rather than being squeezed into half of a two
 * column grid with nothing in the other half.
 */
---

<section class="section systems has-field" id="systems">
  <BlockField variant="video" />

  <div class="container">
    <header class="systems__head reveal">
      <p class="section__no" data-no="01">Systems</p>
      <h2 class="h2">
        <SplitText text="Two platforms in production." />
        <SplitText text="Both still running." offset={4} italic />
      </h2>
    </header>
  </div>

  {
    entries.map((entry, i) => {
      return (
        <article class="sys">
          <div class="container sys__grid">
            {/* Index and year run the full width as a masthead, so each record
                opens on a rule rather than starting cold. */}
            <div class="sys__top reveal">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <span class="sys__year">{entry.data.year}</span>
            </div>

            <div class="sys__body reveal" style={`--i:${i}`}>
              <h3 class="sys__name">
                <SplitText text={entry.data.title} />
              </h3>

              <p class="sys__role">{entry.data.role}</p>
              <p class="sys__summary">{entry.data.summary}</p>

              <ul class="sys__domains">
                {entry.data.domains.map((domain) => (
                  <li class="tag">{domain}</li>
                ))}
              </ul>

              <div class="sys__actions">
                <a class="btn" href={`/work/${entry.id}`}>
                  Read the case study
                  <span class="btn__arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </div>
            </div>

            {/* The record's facts, moved out of the argument column and into
                their own. This is what fills the right half of the block now
                that the diagram plate is gone, and it reads better here
                anyway: the prose sells, the panel verifies. */}
            <aside class="sys__side reveal" style={`--i:${i}`}>
              {entry.data.awards.length > 0 && (
                <div class="sys__block">
                  <p class="sys__block-k">Recognition</p>
                  <ul class="sys__awards">
                    {entry.data.awards.map((award) => (
                      <li class="sys__award">{award}</li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="sys__block">
                <p class="sys__block-k">Stack</p>
                <ul class="sys__stack">
                  {entry.data.stack.map((item) => (
                    <li class="sys__stack-item">{item}</li>
                  ))}
                </ul>
              </div>

              <div class="sys__block">
                <p class="sys__block-k">Sector</p>
                <p class="sys__block-v">{entry.data.sector}</p>
              </div>
            </aside>
          </div>
        </article>
      );
    })
  }
</section>

<style>
  .systems__head {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 46rem;
  }

  .sys {
    padding-top: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  /* A rule between entries, so two records in a single column still read as
     two distinct systems without needing a card around each. */
  .sys + .sys {
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--line-soft);
  }

  .sys__grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: clamp(2.5rem, 5vw, 4.5rem);
    row-gap: clamp(1.5rem, 3vw, 2.25rem);
    align-items: start;
  }

  /* --- masthead ------------------------------------------------------------ */

  .sys__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .sys__year {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  /* --- body --------------------------------------------------------------- */
  .sys__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .sys__name {
    font-size: var(--step-3);
    max-width: 18ch;
  }

  .sys__role {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .sys__summary {
    color: var(--muted);
    max-width: 54ch;
    text-wrap: pretty;
  }

  .sys__domains {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
  }

  .sys__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.75rem;
  }

  /* --- facts column -------------------------------------------------------- */

  .sys__side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    background-color: var(--surface);
  }

  .sys__block {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .sys__block + .sys__block {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-soft);
  }

  .sys__block-k {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .sys__block-v {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .sys__awards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .sys__award {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .sys__award::before {
    content: '◆';
    color: var(--accent-2);
    font-size: 0.7em;
    flex: none;
  }

  .sys__stack {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .sys__stack-item {
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-2);
  }

  @media (min-width: 62rem) {
    /* Two columns: the argument on the left, the record that backs it on the
       right. This is what stops the block sitting in the left third of an
       80rem container with the rest of the width doing nothing. */
    .sys__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }

    .sys__top {
      grid-column: 1 / -1;
    }
  }
</style>
