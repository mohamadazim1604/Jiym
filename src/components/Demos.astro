---
import SplitText from './SplitText.astro';
import BlockField from './BlockField.astro';
import Icon from './Icon.astro';
import DemoTrace from './DemoTrace.astro';
import BookingDemo from './BookingDemo.astro';

const demos = [
  {
    id: 'demo-trace',
    code: 'TRC',
    title: 'Stock and traceability',
    blurb:
      'Change the quantity and watch the FIFO window move. Receipt order decides which lots are drawn, and a single non-compliant lot inside that window changes the status of everything produced from it. Run it and the lineage is written underneath.',
  },
  {
    id: 'demo-booking',
    code: 'BKG',
    title: 'Booking and attendance',
    blurb:
      'Pick a free slot, set a participant count against room capacity, and confirm. The booking issues a QR token; scanning it records a check-in against that booking, which is what turns attendance into a report rather than an assertion.',
  },
];
---

<section class="section demos has-field" id="demos">
  <BlockField variant="streams" />

  <div class="container">
    <header class="demos__head">
      <p class="eyebrow">Live demos</p>
      <h2 class="h2">
        <SplitText text="Not screenshots." />
        <SplitText text="Working software." offset={2} italic />
      </h2>
      <p class="lede">
        Both rebuilt from the real systems and running in your browser. Nothing is saved and a
        refresh returns them to the start.
      </p>
    </header>

    <div class="demos__list">
      {
        demos.map((demo, i) => (
          <article class="demos__item" id={demo.id}>
            <header class="demos__item-head">
              <div class="demos__label">
                <span class="index">{String(i + 1).padStart(2, '0')}</span>
                <span class="demos__code">{demo.code}</span>
                <h3 class="demos__title">{demo.title}</h3>
              </div>
              <p class="demos__blurb">{demo.blurb}</p>
              <p class="demos__live">
                <Icon name="play" size="0.95rem" />
                <span>Running in your browser · nothing is saved</span>
              </p>
            </header>

            <div class="demos__frame">
              {demo.id === 'demo-trace' ? <DemoTrace /> : <BookingDemo />}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .demos__head {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 46rem;
  }

  .demos__list {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 8vw, 6rem);
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .demos__item {
    scroll-margin-top: 6rem;
  }

  .demos__item-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .demos__label {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .demos__code {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--accent-line);
    border-radius: 3px;
    color: var(--accent);
  }

  .demos__title {
    font-size: var(--step-2);
  }

  .demos__blurb {
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--muted);
    max-width: 68ch;
    text-wrap: pretty;
  }

  /* Replaces the old SOURCE readout, which printed a local Windows path on a
     public page: internal detail with nothing in it for a client. */
  .demos__live {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--accent-line);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--accent-2);
    align-self: flex-start;
  }

  .demos__frame {
    /* The demos carry their own chrome, so the wrapper only provides lift. */
    box-shadow: 0 30px 70px -45px var(--shadow);
    border-radius: var(--radius);
  }
</style>
