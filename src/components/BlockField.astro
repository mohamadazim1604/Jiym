---
/**
 * The animated backdrop that sits behind a block.
 *
 * Two kinds. The gradient variants draw three spans and are pure CSS: no
 * requests, no images, no JavaScript. The `video` variant plays a short
 * looping clip behind the block instead, under a veil heavy enough that the
 * copy on top keeps its contrast.
 *
 * All of the drawing and all of the motion lives in global.css under
 * "7b. per-block backdrops", which is what keeps every backdrop on the page
 * reading as one system rather than as a set of one-off decorations.
 */
interface Props {
  /** Which backdrop vocabulary to draw. */
  variant?: 'beam' | 'scan' | 'streams' | 'mesh' | 'aurora' | 'video';
  /** `deep` redraws the same figures in light-on-dark for inverted blocks. */
  tone?: 'light' | 'deep';
  /** Which clip the `video` variant plays. Ignored by every other variant. */
  src?: string;
}

const { variant = 'beam', tone = 'light', src = '/media/section.mp4' } = Astro.props;
---

<div
  class:list={['bfield', `bfield--${variant}`, `bfield--${tone}`]}
  aria-hidden="true"
>
  {
    variant === 'video' ? (
      <Fragment>
        {/*
          `preload="none"`: this clip is never above the fold, and the script
          below only starts it once the block is actually on screen, so paying
          for the bytes up front would be paying for something most visitors
          scrolling past never see.
        */}
        <video
          class="bfield__video"
          src={src}
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          tabindex="-1"
        />
        <span class="bfield__veil" />
        <span class="bfield__c" />
      </Fragment>
    ) : (
      <Fragment>
        <span class="bfield__a" />
        <span class="bfield__b" />
        <span class="bfield__c" />
      </Fragment>
    )
  }
</div>

<script>
  /**
   * Block videos only run while their block is on screen.
   *
   * Decoding video is the most expensive thing on this page and there is more
   * than one of these, so a clip that has scrolled away is stopped rather than
   * left spinning. Also stopped on a hidden tab, on Data Saver, and under
   * prefers-reduced-motion, where the first frame is left up as a still.
   */
  const clips = document.querySelectorAll<HTMLVideoElement>('.bfield__video');

  if (clips.length) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = (navigator as any).connection?.saveData === true;
    const onScreen = new WeakSet<HTMLVideoElement>();

    const settle = (clip: HTMLVideoElement) => {
      const wanted = onScreen.has(clip) && !reduced.matches && !saveData && !document.hidden;

      if (!wanted) {
        clip.pause();
        return;
      }

      // Rejected autoplay is not worth surfacing: the veil and the bloom
      // still carry the block on their own.
      clip.play().catch(() => {});
    };

    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const clip = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) onScreen.add(clip);
          else onScreen.delete(clip);
          settle(clip);
        }
      },
      // A margin, so the clip is already running by the time it is looked at.
      { rootMargin: '200px 0px' },
    );

    for (const clip of clips) watcher.observe(clip);

    const settleAll = () => {
      for (const clip of clips) settle(clip);
    };

    reduced.addEventListener('change', settleAll);
    document.addEventListener('visibilitychange', settleAll);
  }
</script>
